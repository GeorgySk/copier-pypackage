{%- from 'macros.jinja' import release_notes, test_pythons -%}
{%- set pythons = test_pythons(python_version).split() -%}
# Keep the jobs and commands in sync with .github/workflows/ci.yml (if present).
#
# To save compute minutes, what runs depends on the pipeline:
# - merge requests: every check, with the tests on the oldest and newest
#   Python; no pipeline while the merge request is a draft (after marking it
#   ready, start one with "Run pipeline" on its Pipelines tab).
# - the default branch: only the tests on the oldest Python, for the coverage
#   report and the README badges.
# - final release tags (vX.Y.Z, not vX.Y.Z-alpha): every check with the tests
#   on every Python, then the publish and release jobs.
stages: [lint, test, build, publish]

variables:
  PYTHON_VERSION: "{{ python_version }}"
  POETRY_VERSION: "{{ poetry_version }}"

workflow:
  rules:
    - if: $CI_MERGE_REQUEST_DRAFT == "true"
      when: never
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
    - if: $CI_COMMIT_TAG =~ /^v\d+\.\d+\.\d+$/
  # A new pipeline for the same merge request cancels this one, unless a job
  # that isn't interruptible has started.
  auto_cancel:
    on_new_commit: interruptible

default:
  interruptible: true
  timeout: 20 minutes

# Final releases only: tags like v1.2.3, not v1.2.3-alpha.
.release-rules:
  interruptible: false
  rules:
    - if: $CI_COMMIT_TAG =~ /^v\d+\.\d+\.\d+$/

# Merge requests and release tags, not the default branch.
.check-rules:
  rules:
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
      when: never
    - when: on_success

.poetry:
  image: python:$PYTHON_VERSION
  before_script:
    - pip install "poetry==${POETRY_VERSION}"
    - poetry install --with dev

lint:
  extends: [.poetry, .check-rules]
  stage: lint
  script:
    - poetry run ruff check .
    - poetry run mypy .

test:
  extends: .poetry
  stage: test
  parallel:
    matrix:
      - PYTHON_VERSION: {{ pythons | tojson }}
  rules:
    # Every Python on release tags, the oldest and newest on merge requests,
    # the oldest on the default branch.
    - if: $CI_COMMIT_TAG
    - if: >-
        $CI_PIPELINE_SOURCE == "merge_request_event"
{%- if pythons | length > 1 %}
        && ($PYTHON_VERSION == "{{ pythons[0] }}" || $PYTHON_VERSION == "{{ pythons[-1] }}")
{%- else %}
        && $PYTHON_VERSION == "{{ pythons[0] }}"
{%- endif %}
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH && $PYTHON_VERSION == "{{ pythons[0] }}"
  script:
    - poetry run pytest --cov --cov-report=term --cov-report=xml --junitxml=report.xml
  coverage: '/^TOTAL.*\s+(\d+(?:\.\d+)?%)$/'
  artifacts:
    when: always
    reports:
      junit: report.xml
      coverage_report:
        coverage_format: cobertura
        path: coverage.xml

# In the test stage, so broken docs block publishing.
docs:
  extends: .check-rules
  image: python:$PYTHON_VERSION
  stage: test
  script:
    - pip install "poetry==${POETRY_VERSION}"
    - poetry install --with docs
    - poetry run sphinx-build -W --keep-going -b html docs/source docs/build/html

build:
  extends: .check-rules
  image: python:$PYTHON_VERSION
  stage: build
  script:
    - pip install "poetry==${POETRY_VERSION}"
    - poetry build
  artifacts:
    paths:
      - dist/
{%- if ci_provider == "gitlab" %}
{#- With ci_provider == "both", GitHub publishes to PyPI: a second upload of
    the same version would fail. #}

publish-pypi:
  extends: .release-rules
  image: python:$PYTHON_VERSION
  stage: publish
  # PYPI_API_TOKEN: masked, protected CI/CD variable holding a PyPI API token
  script:
    - |
      version="$(sed -n 's/^version = "\(.*\)"$/\1/p' pyproject.toml)"
      if [ "${CI_COMMIT_TAG#v}" != "${version}" ]; then
        echo "Tag ${CI_COMMIT_TAG} does not match version ${version}"
        exit 1
      fi
    - pip install "poetry==${POETRY_VERSION}"
    - poetry publish --username __token__ --password "${PYPI_API_TOKEN}"
{%- endif %}
{%- if use_docker_compose %}

publish-docker:
  extends: .release-rules
  image: docker:cli
  services:
    - docker:dind
  stage: publish
  timeout: 30 minutes
  variables:
    DOCKER_TLS_CERTDIR: "/certs"
  dependencies: []
  before_script:
    - echo "${CI_REGISTRY_PASSWORD}" | docker login --username "${CI_REGISTRY_USER}" --password-stdin "${CI_REGISTRY}"
  script:
    - |
      export $(grep -E '^(PYTHON_IMAGE_VERSION|POETRY_VERSION)=' .env | xargs)
      version="${CI_COMMIT_TAG#v}"
      docker build \
        --build-arg PYTHON_IMAGE_VERSION="${PYTHON_IMAGE_VERSION}" \
        --build-arg POETRY_VERSION="${POETRY_VERSION}" \
        --build-arg IMAGE_TYPE=prod \
        --tag "${CI_REGISTRY_IMAGE}:${version}" \
        --tag "${CI_REGISTRY_IMAGE}:latest" \
        .
      docker push "${CI_REGISTRY_IMAGE}:${version}"
      docker push "${CI_REGISTRY_IMAGE}:latest"
{%- endif %}

# A GitLab release for each final version, with the version's CHANGES.rst
# section as release notes. Independent of the publish jobs: the tag is the
# release, and a failed upload is re-run rather than abandoned.
release:
  extends: .release-rules
  image: registry.gitlab.com/gitlab-org/cli:latest
  stage: publish
  dependencies: []
  script:
    - |
      {{ release_notes("CI_COMMIT_TAG") | indent(6) }}
  release:
    tag_name: $CI_COMMIT_TAG
    name: $CI_COMMIT_TAG
    description: release-notes.md

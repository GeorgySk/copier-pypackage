{% from 'macros.jinja' import ruff_version -%}
repos:
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v{{ ruff_version() }}  # keep equal to the ruff pin in pyproject.toml
    hooks:
      - id: ruff-check
        args: [--fix]
  # Uses the mypy from the project environment (`poetry install --with dev`),
  # so it sees the project's dependencies and needs no separate pin.
  - repo: local
    hooks:
      - id: mypy
        name: mypy
        entry: mypy .
        language: system
        types: [python]
        pass_filenames: false

{% from 'macros.jinja' import copyright_header, escape_double_quoted,
    python_string -%}
{{ copyright_header(open_source_license, full_name) }}{%- set summary = escape_double_quoted(((project_short_description | trim) ~ ".") | wordwrap(72, break_long_words=false, break_on_hyphens=false)) -%}
{%- if "\n" in summary -%}
"""
{{ summary }}
"""
{%- else -%}
"""{{ summary }}"""
{%- endif %}

__author__ = {{ python_string(full_name) }}
__email__ = {{ python_string(email) }}
__version__ = "{{ version }}"

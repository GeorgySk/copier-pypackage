version: 2
updates:
  # Poetry: pyproject.toml (+ poetry.lock, if committed)
  - package-ecosystem: "pip"
    directory: "/"
    schedule:
      interval: "weekly"
    groups:
      python-minor-patch:
        update-types: ["minor", "patch"]
{%- if use_devcontainer %}
  # .devcontainer/devcontainer.json
  - package-ecosystem: "devcontainers"
    directory: "/"
    schedule:
      interval: "weekly"
{%- endif %}
{%- if ci_provider in ["github", "both"] %}
  # .github/workflows/*.yml
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
{%- endif %}

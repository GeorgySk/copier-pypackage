ARG PYTHON_IMAGE_VERSION
ARG IMAGE_TYPE

FROM python:${PYTHON_IMAGE_VERSION} AS base
ARG POETRY_VERSION

WORKDIR /opt/{{ project_slug }}

# An environment variable, unlike `poetry config`, applies to every user,
# including the dev container's non-root user.
ENV POETRY_VIRTUALENVS_CREATE=false
RUN pip install "poetry==${POETRY_VERSION}"

COPY README.md .
COPY docs/ docs/
COPY tests/ tests/
COPY {{ project_slug }}/ {{ project_slug }}/
COPY pyproject.toml .
COPY LICENSE .

FROM base AS prod
RUN poetry install

FROM base AS dev
RUN poetry install --with dev

FROM ${IMAGE_TYPE}

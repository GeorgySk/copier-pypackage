services:
  {{project_slug}}:
    build:
      context: .
      args:
        - PYTHON_IMAGE_VERSION=${PYTHON_IMAGE_VERSION}
        - POETRY_VERSION=${POETRY_VERSION}
        - IMAGE_TYPE=${IMAGE_TYPE}
    image: {{ github_username.lower() }}/{{project_slug}}:{{version}}
    volumes:
      - .:/opt/{{project_slug}}
    stdin_open: true
    tty: true

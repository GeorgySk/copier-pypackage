[tool.bumpversion]
commit = {{ "true" if use_devcontainer else "false" }}
# Tags need a commit; pushing a final vX.Y.Z tag triggers the CI publish jobs.
tag = {{ "true" if use_devcontainer else "false" }}
tag_name = "v{new_version}"
current_version = "{{ version }}"
parse = "(?P<major>\\d+)\\.(?P<minor>\\d+)\\.(?P<patch>\\d+)(\\-(?P<release>[a-z]+))?"
serialize = [
    "{major}.{minor}.{patch}-{release}",
    "{major}.{minor}.{patch}"
]
{%- if use_docker_compose %}

[[tool.bumpversion.files]]
filename = "compose.yaml"
{%- endif %}

[[tool.bumpversion.files]]
filename = "{{ project_slug }}/__init__.py"

[[tool.bumpversion.files]]
filename = "pyproject.toml"

# On release, turn the "Unreleased" section into a dated version section
# and start a new empty "Unreleased" section above it.
[[tool.bumpversion.files]]
filename = "CHANGES.rst"
search = "Unreleased\n----------"
replace = "Unreleased\n----------\n\n{new_version} ({now:%Y-%m-%d})\n------------------------------"
include_bumps = ["release"]

[tool.bumpversion.parts.release]
optional_value = "beta"
values = [
	"alpha",
	"beta"
]

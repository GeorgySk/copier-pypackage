{
  "name": "copier-pypackage",
  "dockerComposeFile": ["../compose.yaml", "compose.devcontainer.yaml"],
  "service": "copier-pypackage",
  "overrideCommand": true,
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },
  "workspaceFolder": "/opt/copier-pypackage",
  "onCreateCommand": "bash /opt/copier-pypackage/.devcontainer/setup_user.sh",
  "remoteUser": "vscode"
}

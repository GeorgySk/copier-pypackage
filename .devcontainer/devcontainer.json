{
  "name": "cookiecutter-pypackage",
  "dockerComposeFile": ["../compose.yaml", "compose.devcontainer.yaml"],
  "service": "cookiecutter-pypackage",
  "overrideCommand": true,
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },
  "workspaceFolder": "/opt/cookiecutter-pypackage",
  "onCreateCommand": "bash /opt/cookiecutter-pypackage/.devcontainer/setup_user.sh",
  "remoteUser": "${localEnv:USER}"
}

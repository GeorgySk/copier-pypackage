{#-
Macros for the template, imported with
``{% from 'macros.jinja' import ... %}``. Copier resolves imports from the
repository root (not from ``_subdirectory``), so this file is never rendered
into a project. Macros instead of Jinja extensions: extensions are an unsafe
Copier feature and would make every user pass ``--trust``.
-#}

{#- The generated project's dev and docs dependencies, from
template-dependencies/pyproject.toml, where this repository's Dependabot
updates them: the body of its [dependency-groups] table, which comes last
in that file (the header that starts a line; ``trim`` drops a CR left by a
CRLF checkout). -#}
{%- macro dependency_groups() -%}
{%- set text %}{% include 'template-dependencies/pyproject.toml' %}{% endset -%}
{{ text.rsplit('\n[dependency-groups]', 1)[1] | trim }}
{%- endmacro -%}

{#- The Ruff version pinned in the dev group above, for the ruff-pre-commit
rev. -#}
{%- macro ruff_version() -%}
{{ dependency_groups().split('"ruff==', 1)[1].split('"', 1)[0] }}
{%- endmacro -%}

{#- Escape ``value`` for use between double quotes: valid inside a TOML basic
string ("...") and a Python string literal ("..." or """..."""), as long as
``value`` has no control characters (prompt answers are single lines). -#}
{%- macro escape_double_quoted(value) -%}
{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') }}
{%- endmacro -%}

{#- Render ``value`` as a Python string literal, quotes included: double
quotes, unless the value has more double than single quotes. A generated
project then passes Ruff's quote rules (Q000, Q003) whatever the prompt
answer was. -#}
{%- macro python_string(value) -%}
{%- set text = value | string | replace('\\', '\\\\') -%}
{%- if text.count('"') > text.count("'") -%}
'{{ text | replace("'", "\\'") }}'
{%- else -%}
"{{ text | replace('"', '\\"') }}"
{%- endif -%}
{%- endmacro -%}

{#- Licenses that only ask for the copyright notice to accompany copies of
the work, which the LICENSE file already does: per-file notices add nothing,
so the generated Ruff config ignores CPY001 and the ``.py`` files get no
header. Every other license gets both. -#}
{%- set licenses_without_file_notices = [
    'MIT license', 'BSD license', 'ISC license'
] -%}

{#- The comment block that starts every generated ``.py`` file when the
license calls for per-file notices (see above), empty otherwise. It matches
Ruff's CPY001 pattern, adds an SPDX identifier for the open source licenses,
and ends with ``trailer`` (a blank line by default) to separate it from the
code. The name loses surrounding whitespace (W291) and trailing backslashes,
which make Ruff take the comment for commented-out code (ERA001). -#}
{%- macro copyright_header(open_source_license, full_name, trailer='\n') -%}
{%- if open_source_license not in licenses_without_file_notices -%}
{%- set name = full_name | string | trim
    | regex_replace('[\\s\\\\]+\\Z', '') -%}
{{ '# Copyright (c) ' ~ ('%Y' | strftime) ~ (', ' ~ name if name else '') ~ '\n' }}
{%- if open_source_license == 'Apache Software License 2.0' -%}
{{ '# SPDX-License-Identifier: Apache-2.0\n' }}
{%- elif open_source_license == 'GNU General Public License v3' -%}
{{ '# SPDX-License-Identifier: GPL-3.0-or-later\n' }}
{%- endif -%}
{{ trailer }}
{%- endif -%}
{%- endmacro -%}

{#- Shell commands for the CI ``release`` jobs: check that the tag in the
variable ``tag_variable`` matches the version in ``pyproject.toml``, then
write that version's ``CHANGES.rst`` section to ``release-notes.md``. The
section ends at the next ``-``-underlined heading (the previous version);
its ``~``-underlined subsection headings become ``###`` headings, since a
``~~~`` line opens a code block in Markdown. The rest of reStructuredText
(bullets, ````code````) reads well enough as Markdown. POSIX ``sh`` and
``awk`` only: GitLab runs it in an Alpine-based image. The template
repository's own ``.github/workflows/release.yml`` carries a copy, which
``test_release_notes_in_sync`` keeps identical. -#}
{%- macro release_notes(tag_variable) -%}
set -e
version="{{ '${' ~ tag_variable ~ '#v}' }}"
project_version="$(sed -n 's/^version = "\(.*\)"$/\1/p' pyproject.toml)"
if [ "${version}" != "${project_version}" ]; then
  echo "Tag v${version} does not match version ${project_version}" >&2
  exit 1
fi
awk -v version="${version}" '
  { line[NR] = $0 }
  END {
    for (i = 1; i < NR; i++) {
      if (index(line[i], version " (") == 1 && line[i + 1] ~ /^-+$/) {
        start = i + 2
        break
      }
    }
    if (!start) {
      print "No section for " version " in CHANGES.rst" > "/dev/stderr"
      exit 1
    }
    for (i = start; i <= NR; i++) {
      if (line[i + 1] ~ /^-+$/) break
      if (line[i + 1] ~ /^~+$/) {
        print "### " line[i]
        i++
      } else print line[i]
    }
  }' CHANGES.rst > release-notes.md
if ! grep -q '[^[:space:]]' release-notes.md; then
  echo "No notable changes." > release-notes.md
fi
{%- endmacro -%}

{#- The Python versions the CI tests run on, space-separated and oldest
first: from the project's minimum ``python_version`` to the newest release.
When a new Python is released, raise the 15 and add the version to the
``python_version`` choices in copier.yml. Both CI files run all of them on
release tags, the first and last on pull/merge requests, and the first (with
coverage) on the default branch. -#}
{%- macro test_pythons(python_version) -%}
{%- for minor in range(python_version.split('.')[1] | int, 15) -%}
3.{{ minor }}{{ ' ' if not loop.last else '' }}
{%- endfor -%}
{%- endmacro -%}

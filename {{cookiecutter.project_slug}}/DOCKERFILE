ARG IMAGE_NAME
ARG IMAGE_VERSION

FROM ${IMAGE_NAME}:${IMAGE_VERSION}

ARG POETRY_VERSION

RUN pip install --upgrade pip setuptools
RUN pip install "poetry==${POETRY_VERSION}"

WORKDIR /opt/gon

COPY pyproject.toml .
RUN poetry config virtualenvs.create false
RUN poetry install

COPY README.md .
COPY pytest.ini .
COPY {{ cookicutter.project_slug }} {{ cookicutter.project_slug }}
COPY tests tests
